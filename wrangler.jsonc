{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reseauxmanager",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Adresse publique de l'app : https://reseauxmanager.<sous-domaine>.workers.dev
  "workers_dev": true,
  // Garde les variables ajoutées dans le tableau de bord Cloudflare lors des mises à jour.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/m/*"]
  },
  // Base de données (déjà créée) et stockage des médias (créé au premier déploiement).
  "d1_databases": [{ "binding": "DB", "database_name": "plateau-db", "database_id": "eb159db2-b2a1-4af7-a0db-3286f721d7bd" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "plateau-media" }],
  // Vérifie chaque minute les posts arrivés à l'heure.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "IG_API_VERSION": "v24.0",
    "AI_MODEL": "claude-haiku-5-5"
  },
  "observability": { "enabled": true }
}
